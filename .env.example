# Provider-side signature
PROVIDER_SECRET=replace-me
PROVIDER_SIGNATURE_HEADER=X-Provider-Signature
PROVIDER_SIGNATURE_ALGORITHM=hmac-sha256
PROVIDER_SIGNATURE_ENCODING=hex
PROVIDER_SIGNATURE_PREFIX=

# Hermes destination
HERMES_URL=http://hermes-address:8644/webhooks/example
HERMES_SECRET=replace-me

# Relay runtime
PROVIDER_DOCKER_NETWORK=internal
RELAY_BIND_IP=0.0.0.0
RELAY_PORT=8080
HERMES_TIMEOUT_SECONDS=10
